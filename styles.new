@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Inter:wght@300;400;500&display=swap');
:root{--paper:#ecebe5;--ink:#11120f;--acid:#d8ff3e;--line:rgba(17,18,15,.18);--muted:#777970;--mono:"DM Mono",monospace}
*{box-sizing:border-box}html,body{width:100%;height:100%;overflow:hidden}body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,sans-serif}button,a{color:inherit;font:inherit}button{border:0;cursor:pointer}button:focus-visible,a:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
header{position:fixed;z-index:50;inset:0 0 auto;height:64px;padding:0 28px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid var(--line);background:#ecebe5bb;backdrop-filter:blur(12px)}.logo{text-decoration:none;font:500 .76rem var(--mono);letter-spacing:.18em}.logo span{color:#888b81}header p{font:400 .52rem var(--mono);color:var(--muted);letter-spacing:.09em}header button{justify-self:end;background:none;font:500 .6rem var(--mono);letter-spacing:.1em}
#viewport{position:relative;width:100%;height:100%;overflow:hidden;cursor:grab;touch-action:none}#viewport.drag{cursor:grabbing}#space{position:absolute;inset:0;width:100%;height:100%;opacity:.75}.intro{position:absolute;z-index:3;left:5vw;top:14vh;pointer-events:none;transition:opacity .4s}.intro small,.intro p{font:400 .54rem/1.65 var(--mono);letter-spacing:.09em;text-transform:uppercase}.intro small{color:var(--muted)}.intro h1{margin:1rem 0;font-size:clamp(3rem,7vw,7rem);font-weight:300;line-height:.84;letter-spacing:-.075em}
.scene{position:absolute;z-index:5;inset:0;perspective:1100px;perspective-origin:50% 48%;transform-style:preserve-3d}#world{position:absolute;left:50%;top:50%;width:1px;height:1px;transform-style:preserve-3d;will-change:transform}.cluster{position:absolute;width:1px;height:1px;transform-style:preserve-3d}.ca{transform:translate3d(-560px,-70px,0)}.cb{transform:translate3d(0,80px,-180px)}.cc{transform:translate3d(600px,-35px,-50px)}.label{position:absolute;width:210px;transform:translate3d(-105px,-265px,20px);text-align:center;pointer-events:none}.label small{font:400 .5rem var(--mono);color:var(--muted)}.label h2{margin:.5rem;font-size:1.15rem;font-weight:400}
.card{--x:0px;--y:0px;--z:0px;position:absolute;left:-90px;top:-120px;width:180px;height:240px;padding:13px;display:flex;flex-direction:column;align-items:stretch;transform:translate3d(var(--x),var(--y),var(--z));background:#faf9f3;border:1px solid var(--line);box-shadow:0 18px 45px #11120f1a;text-align:left;backface-visibility:visible;transition:.25s}.card:hover{border-color:var(--ink);box-shadow:0 25px 60px #11120f36}.card>small:first-child{font:400 .46rem var(--mono);color:var(--muted)}.card .art{position:relative;flex:1;margin:10px 0 12px;overflow:hidden;border-block:1px solid}.card strong{font-size:.7rem}.card em{margin-top:4px;font:normal .42rem var(--mono);opacity:.62;text-transform:uppercase}.card.dark{background:#171815;color:#eeeee8}.card.acid{background:var(--acid)}.card:nth-of-type(2){--x:-130px;--y:-85px;--z:65px}.card:nth-of-type(3){--x:105px;--y:-48px;--z:-40px}.card:nth-of-type(4){--x:-238px;--y:155px;--z:-90px}.card:nth-of-type(5){--x:18px;--y:182px;--z:80px}.card:nth-of-type(6){--x:260px;--y:125px;--z:-30px}.card:nth-of-type(7){--x:300px;--y:-145px;--z:-150px}.cb .card:nth-of-type(2),.cc .card:nth-of-type(2){--x:-165px;--y:-150px;--z:-20px}.cb .card:nth-of-type(3),.cc .card:nth-of-type(3){--x:85px;--y:-195px;--z:90px}.cb .card:nth-of-type(4),.cc .card:nth-of-type(4){--x:245px;--y:15px;--z:-80px}.cb .card:nth-of-type(5),.cc .card:nth-of-type(5){--x:75px;--y:135px;--z:110px}.cb .card:nth-of-type(6),.cc .card:nth-of-type(6){--x:-195px;--y:135px;--z:-60px}.cb .card:nth-of-type(7),.cc .card:nth-of-type(7){--x:-345px;--y:-45px;--z:90px}
.art.lines{background:repeating-linear-gradient(164deg,transparent 0 10px,currentColor 11px,transparent 12px 21px)}.art.grid{background:linear-gradient(90deg,transparent 49%,currentColor 50%,transparent 51%),linear-gradient(transparent 49%,currentColor 50%,transparent 51%);background-size:22px 22px}.art.dots{background:radial-gradient(circle,currentColor 0 1px,transparent 1.5px);background-size:8px 8px;mask-image:radial-gradient(circle,#000,transparent 70%)}.art.rings{background:repeating-radial-gradient(ellipse at 50% 55%,transparent 0 11px,currentColor 12px,transparent 13px 23px)}.art.signal:before{content:"";position:absolute;left:50%;top:50%;width:8px;height:8px;border-radius:50%;background:currentColor;transform:translate(-50%,-50%);box-shadow:0 0 0 16px transparent,0 0 0 17px currentColor,0 0 0 34px transparent,0 0 0 35px currentColor,0 0 0 55px transparent,0 0 0 56px currentColor}.art.blocks{background:conic-gradient(from 20deg at 40% 50%,transparent,currentColor 2deg,transparent 4deg 38deg,currentColor 40deg,transparent 42deg)}
nav{position:absolute;z-index:30;left:28px;bottom:25px;display:flex;gap:5px}nav button{min-width:124px;padding:10px 13px;background:#ecebe5c9;border:1px solid var(--line);font:400 .5rem var(--mono);letter-spacing:.08em;text-align:left;backdrop-filter:blur(9px)}nav button span{margin-right:12px;color:var(--muted)}nav button.active{background:var(--ink);color:var(--paper)}.hint{position:absolute;z-index:20;right:28px;bottom:25px;display:flex;gap:10px;align-items:center;font:400 .45rem/1.5 var(--mono)}.hint>span:first-child{border:1px solid var(--line);border-radius:50%}
#detail,#about{position:fixed;z-index:70;right:18px;top:82px;width:min(380px,calc(100vw - 36px));padding:25px;background:#faf9f3f5;border:1px solid var(--ink);box-shadow:0 25px 80px #11120f2e;transform:translateX(calc(100% + 40px));transition:transform .35s;backdrop-filter:blur(15px)}#detail.open{transform:none}#detail .close{position:absolute;right:15px;top:10px;background:none;font-size:1.6rem}#detail small,#about small{font:400 .5rem var(--mono);letter-spacing:.1em;color:var(--muted)}#detail h2{margin:45px 0 20px;font-size:2.7rem;font-weight:300;letter-spacing:-.06em}#detail p,#about p{font-size:.74rem;line-height:1.65}#detail>small:last-child{display:block;margin-top:50px;padding-top:12px;border-top:1px solid var(--line)}#about{width:330px;background:var(--ink);color:var(--paper);transform:translateY(-15px);opacity:0;pointer-events:none}#about.open{transform:none;opacity:1;pointer-events:auto}#about p:last-child{margin-top:30px;font-family:var(--mono);font-size:.5rem;color:#aaa}
@media(max-width:800px){header{padding:0 16px;grid-template-columns:1fr 1fr}header p{display:none}.intro{left:18px;top:12vh}.intro h1{font-size:15vw}.cluster{scale:.7}.ca{transform:translate3d(-420px,-40px,0)}.cb{transform:translate3d(0,65px,-180px)}.cc{transform:translate3d(420px,-25px,-50px)}nav{left:14px;right:14px;bottom:14px}nav button{min-width:0;flex:1;padding:10px 7px;text-align:center}nav button span{display:none}.hint{display:none}}@media(max-width:480px){.cluster{scale:.56}nav button{font-size:.42rem}}
